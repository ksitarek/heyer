{
    "StorageStrategy": {
        "Type": "Filesystem",
        "FilesystemStorage": {
            "RootPath": "./tmpstorage"
        }
    },
    "RegistryStrategy": {
        "Type": "SqlServer",
        "TempFileLifespan": 86400,
        "MongoDbRegistry": {
            "ConnectionString": "mongodb://localhost:27017",
            "DatabaseName": "HeyerStorageRegistry",
            "CollectionName": "StorageRegistry"
        },
        "SqlServerRegistry": {
            "ConnectionString": "Server=localhost,41433;Database=Storage;User Id=sa;Password=yourStrong(!)Password;TrustServerCertificate=True;"
        }
    },
    "Jwt": {
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ValidateIssuerSigningKey": true,
        "ValidIssuer": "heyer",
        "ValidAudience": "heyer",
        "Secret": ""
    },
    "CleanupService": {
        "Interval": 300
    }
}
