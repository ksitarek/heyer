{
    "StorageStrategy": {
        "Type": "Filesystem",
        "FilesystemStorage": {
            "RootPath": "./tmpstorage"
        }
    },
    "RegistryStrategy": {
        "Type": "Npgsql",
        "TempFileLifespan": 86400,
        "MongoDbRegistry": {
            "ConnectionString": "mongodb://localhost:27017",
            "DatabaseName": "HeyerStorageRegistry",
            "CollectionName": "StorageRegistry"
        },
        "NpgsqlRegistry": {
            "ConnectionString": "Host=localhost;Port=5432;Database=storage;TrustServerCertificate=True"
        }
    },
    "CleanupService": {
        "Interval": 300
    },
    "Cors": {
        "AllowedOrigins": [
            "http://localhost:4200",
            "http://localhost:4300"
        ]
    }
}
