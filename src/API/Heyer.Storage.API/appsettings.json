{
  "StorageStrategy": {
    "Type": "Filesystem",
    "FilesystemStorage": {
      "RootPath": "./tmpstorage"
    }
  },
  
  "RegistryStrategy": {
    "Type": "MongoDb",
    "MongoDbRegistry": {
      "ConnectionString": "mongodb://localhost:27017",
      "DatabaseName": "HeyerStorageRegistry"
    }
  }
}
