{
  "StorageStrategy": {
    "Type": "Filesystem",
    "FilesystemStorage": {
      "RootPath": "./tmpstorage"
    }
  },
  
  "RegistryStrategy": {
    "Type": "MongoDb",
    "MongoDbRegistry": {
      "ConnectionString": "mongodb://localhost:27017",
      "DatabaseName": "HeyerStorageRegistry",
      "CollectionName": "StorageRegistry"
    }
  },
  
  "Jwt": {
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true,
    "ValidIssuer": "heyer",
    "ValidAudience": "heyer",
    "Secret": ""
  }
}
